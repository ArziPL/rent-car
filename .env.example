# Copy this file to .env and fill in real values — .env is never committed.
# Generate JWT_SECRET with: openssl rand -base64 32
JWT_SECRET=replace-with-base64-encoded-256bit-secret
DB_USERNAME=rentcar
DB_PASSWORD=rentcar
POSTGRES_PASSWORD=rentcar

# Optional — override the CORS allowed origins (comma-separated).
# Default is http://localhost:3000 (the frontend in dev and Docker).
# CORS_ALLOWED_ORIGINS=http://localhost:3000
